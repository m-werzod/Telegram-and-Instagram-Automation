# SITE_ADDRESS is injected from .env (e.g. 77-93-152-116.sslip.io).
#
# `tls internal` makes Caddy issue its own locally-generated certificate
# instead of requesting one from Let's Encrypt. Use this whenever the host
# sits behind something that intercepts public ACME validation on ports
# 80/443 before it reaches this container (e.g. a shared-IP hosting
# provider's gateway) — browsers show a one-time "not trusted" warning to
# click past, but the site is otherwise fully functional over real HTTPS
# (session cookies work, etc.). A server-side proxy (Vercel's rewrite, for
# instance) will NOT accept this certificate — only an interactive browser
# that a person can click "proceed anyway" on.
#
# Once the host is genuinely reachable on standard ports 80/443 from the
# public internet (fixed hosting-provider routing, or a dedicated IP),
# delete the `tls internal` line below and restart Caddy — it will then
# request a real, publicly-trusted Let's Encrypt certificate automatically,
# and every client (including Vercel's proxy) will work with no warning.
{$SITE_ADDRESS} {
	tls internal

	encode gzip
	reverse_proxy app:3000
}

# ── Public domain behind a TLS-terminating hosting gateway ──────────────────
# On a shared-IP/NAT plan (e.g. Database Mart), public 80/443 belong to the
# provider's gateway, which terminates TLS with its own certificate and
# forwards PLAINTEXT to a mapped inner port. Caddy therefore must NOT try to
# serve TLS for that hostname — it cannot complete an ACME challenge anyway,
# since it never sees public 80/443. The explicit `http://` scheme disables
# automatic HTTPS and the HTTP→HTTPS redirect for this site only.
#
# Point the provider's domain mapping at inner port 80 and set PUBLIC_DOMAIN
# in .env. Left unset, this block matches a hostname nobody can resolve, so it
# is inert.
# Which of the two the gateway actually does is its implementation detail and
# is not documented, so serve BOTH rather than guess: plaintext on :80, and TLS
# on :443 with a locally-issued certificate the gateway accepts from its own
# backend. Whichever it forwards, Caddy answers — and the operator never has to
# delete and recreate the mapping to find out which.
http://{$PUBLIC_DOMAIN:public-domain-not-configured.invalid} {
	encode gzip
	reverse_proxy app:3000
}

https://{$PUBLIC_DOMAIN:public-domain-not-configured.invalid} {
	# Not a publicly-trusted certificate, and it does not need to be: the public
	# certificate is the gateway's. This one only has to satisfy the hop between
	# the gateway and this container.
	tls internal
	encode gzip
	reverse_proxy app:3000
}
