# SITE_ADDRESS is injected from .env (e.g. 77-93-152-116.sslip.io).
#
# `tls internal` makes Caddy issue its own locally-generated certificate
# instead of requesting one from Let's Encrypt. Use this whenever the host
# sits behind something that intercepts public ACME validation on ports
# 80/443 before it reaches this container (e.g. a shared-IP hosting
# provider's gateway) — browsers show a one-time "not trusted" warning to
# click past, but the site is otherwise fully functional over real HTTPS
# (session cookies work, etc.). A server-side proxy (Vercel's rewrite, for
# instance) will NOT accept this certificate — only an interactive browser
# that a person can click "proceed anyway" on.
#
# Once the host is genuinely reachable on standard ports 80/443 from the
# public internet (fixed hosting-provider routing, or a dedicated IP),
# delete the `tls internal` line below and restart Caddy — it will then
# request a real, publicly-trusted Let's Encrypt certificate automatically,
# and every client (including Vercel's proxy) will work with no warning.
{$SITE_ADDRESS} {
	tls internal

	encode gzip
	reverse_proxy app:3000
}

# ── Traffic arriving through a TLS-terminating hosting gateway ──────────────
# On a shared-IP/NAT plan the provider owns public 80/443. Its gateway holds
# the publicly-trusted certificate for your domain, terminates TLS there, and
# forwards PLAINTEXT to whichever inner port the domain is mapped to. Measured
# against the live gateway: with a valid Let's Encrypt certificate in front, a
# request to inner 443 still arrived as plain HTTP and Caddy answered
# "Client sent an HTTP request to an HTTPS server".
#
# So the gateway's domain mapping must point at inner port 80, and this site
# serves it: no TLS, no HTTP→HTTPS redirect, any Host. It is deliberately a
# catch-all rather than a named domain, so adding a second domain in the
# provider's panel needs no change here and no redeploy.
#
# Caddy routes by specificity, so the named site above still wins for
# SITE_ADDRESS on :80 and keeps redirecting it to HTTPS. Inner 443 therefore
# stays TLS, which is what the dashboard's Vercel proxy connects to.
:80 {
	encode gzip
	reverse_proxy app:3000
}
