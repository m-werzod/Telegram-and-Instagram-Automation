# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public HTTPS base URL of this deployment. Required for webhooks
# (Telegram setWebhook + the Meta callback URL). Example: https://bots.example.com
APP_URL=
LOG_LEVEL=info

# ── Database (PostgreSQL with the pgvector extension) ────────────────────────
# docker compose up -d db  →  postgresql://platform:platform@localhost:5432/platform
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform

# ── Redis (optional) ─────────────────────────────────────────────────────────
# When set, jobs run on BullMQ (recommended in production).
# When empty, an in-process queue is used (fine for development).
REDIS_URL=

# ── Secrets ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=72

# ── AI providers ─────────────────────────────────────────────────────────────
# Anthropic Claude — powers all agents. https://platform.claude.com/
ANTHROPIC_API_KEY=
# Semantic retrieval for knowledge bases: voyage | openai | none
# 'none' falls back to Postgres full-text search (works, lower quality).
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ── Meta / Instagram (Instagram API with Instagram Login) ────────────────────
# From https://developers.facebook.com/apps/ → your Business app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# A value YOU invent; enter the same string in the Meta App Dashboard webhook config.
META_VERIFY_TOKEN=
# Optional: seed the Instagram connection at boot instead of using the dashboard.
INSTAGRAM_ACCESS_TOKEN=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Optional: seed the Telegram connection at boot instead of using the dashboard.
# Get a token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# ── Initial admin (used by `pnpm db:seed`) ───────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
TENANT_NAME=My Business
