# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public HTTPS base URL of this deployment. Required for webhooks
# (Telegram setWebhook + the Meta callback URL). Example: https://bots.example.com
APP_URL=
LOG_LEVEL=info
# Set to true ONLY behind a reverse proxy that overwrites X-Forwarded-For.
# When the app is exposed directly, leave false or clients can spoof their IP
# past per-IP rate limits (including the login throttle).
TRUST_PROXY=false

# ── Database (PostgreSQL with the pgvector extension) ────────────────────────
# docker compose up -d db  →  postgresql://platform:platform@localhost:5432/platform
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED in production (durable queue + rate-limit state). When empty in
# development, an in-process queue is used. To knowingly run production
# without Redis (single node), set ALLOW_INLINE_QUEUE=true.
REDIS_URL=

# ── Secrets ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=72

# ── AI providers ─────────────────────────────────────────────────────────────
# Each agent picks a model; the provider follows from the model id. Set the key
# for whichever provider your agents' models belong to (both is fine). Either
# key can also be pasted in the dashboard (Settings) with no redeploy.
#
#   claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5  → ANTHROPIC_API_KEY
#   gpt-5 / gpt-5-mini / gpt-5-nano                     → OPENAI_API_KEY
#
# Anthropic Claude — https://platform.claude.com/ (keys start with sk-ant-)
ANTHROPIC_API_KEY=
# OpenAI ChatGPT — https://platform.openai.com/api-keys (keys start with sk-)
# The same key also powers OpenAI embeddings below.
OPENAI_API_KEY=
# Optional: an OpenAI-COMPATIBLE gateway instead of the official API.
OPENAI_BASE_URL=
# Semantic retrieval for knowledge bases: voyage | openai | none
# 'none' falls back to Postgres full-text search (works, lower quality).
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=

# ── Meta / Instagram (Instagram API with Instagram Login) ────────────────────
# From https://developers.facebook.com/apps/ → your Business app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# A value YOU invent; enter the same string in the Meta App Dashboard webhook config.
META_VERIFY_TOKEN=
# Optional: seed the Instagram connection at boot instead of using the dashboard.
INSTAGRAM_ACCESS_TOKEN=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Optional: seed the Telegram connection at boot instead of using the dashboard.
# Get a token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# ── Initial admin (used by `pnpm db:seed`) ───────────────────────────────────
# Dashboard sign-in is Login + Password. Defaults: Admin / Admin3737
ADMIN_LOGIN=Admin
ADMIN_PASSWORD=Admin3737
TENANT_NAME=Turon Avtomaktab
