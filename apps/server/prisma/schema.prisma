// Prisma schema — multi-tenant omnichannel AI automation platform.
// PostgreSQL with the pgvector extension for semantic knowledge retrieval.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────── Tenancy & auth ───────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  agents                   Agent[]
  knowledgeBases           KnowledgeBase[]
  channelConnections       ChannelConnection[]
  leads                    Lead[]
  conversations            Conversation[]
  webhookEvents            WebhookEvent[]
  aiExecutions             AIExecution[]
  toolExecutions           ToolExecution[]
  crmNotes                 CrmNote[]
  handoffs                 HumanHandoff[]
  manualActions            ManualAction[]
  auditLogs                AuditLog[]
  idempotencyKeys          IdempotencyKey[]
  mediaAssets              MediaAsset[]
  appSettings              AppSetting[]
  telegramPersonalAccounts TelegramPersonalAccount[]
  courseRegistrations      CourseRegistration[]
  ownerInstructions        OwnerInstruction[]
}

enum UserRole {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /**
   * Login name for the dashboard (authentication is by username, not email).
   */
  username     String   @unique
  email        String?  @unique
  passwordHash String
  name         String
  role         UserRole @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions              AuthSession[]
  assignedLeads         Lead[]               @relation("AssignedLeads")
  assignedRegistrations CourseRegistration[] @relation("AssignedRegistrations")

  @@index([tenantId])
}

model AuthSession {
  id        String   @id // sha256 hash of the session token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────── Agents ───────────────────────────────

enum AgentType {
  INSTAGRAM_COMMENT
  INSTAGRAM_DM
  TELEGRAM
  /**
   * Automates the owner's PERSONAL Telegram account chats (not the bot's).
   */
  TELEGRAM_PERSONAL
}

model Agent {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type               AgentType
  name               String
  enabled            Boolean        @default(false)
  systemInstructions String         @default("")
  businessObjective  String         @default("")
  tone               String         @default("friendly, professional")
  language           String         @default("auto") // "auto" = detect; or a fixed code e.g. "uz", "ru", "en"
  provider           String         @default("anthropic")
  model              String         @default("claude-opus-5")
  knowledgeBaseId    String?
  knowledgeBase      KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  // Escalation rules and channel-specific behavior knobs (validated by Zod at the app layer).
  escalationRules    Json           @default("{}")
  settings           Json           @default("{}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  conversations Conversation[]
  aiExecutions  AIExecution[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

// ─────────────────────────────── Knowledge base ───────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents                KnowledgeDocument[]
  chunks                   KnowledgeChunk[]
  agents                   Agent[]
  telegramPersonalAccounts TelegramPersonalAccount[]

  @@index([tenantId])
}

enum DocumentSourceType {
  FILE
  URL
  TEXT
  FAQ
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeDocument {
  id              String             @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  tenantId        String
  title           String
  sourceType      DocumentSourceType
  sourceRef       String             @default("") // filename or URL
  mimeType        String             @default("")
  status          DocumentStatus     @default(PENDING)
  error           String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  chunks KnowledgeChunk[]
  file   KnowledgeFile?

  @@index([knowledgeBaseId])
  @@index([tenantId])
}

/**
 * Raw uploaded/ingested source bytes, stored in Postgres so the application
 * holds NO production state on local disk (stateless deployments, no volume).
 * Documents are ≤20MB, so bytea is appropriate at this scale.
 */
model KnowledgeFile {
  documentId String            @id
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId   String
  data       Bytes
  createdAt  DateTime          @default(now())

  @@index([tenantId])
}

model KnowledgeChunk {
  id              String                   @id @default(cuid())
  documentId      String
  document        KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  tenantId        String
  ord             Int
  content         String
  tokenCount      Int                      @default(0)
  metadata        Json                     @default("{}")
  // Untyped pgvector column: supports any embedding dimension; similarity search uses
  // exact scan (fine for KB scale). A dimension-typed column + HNSW index can be added
  // in a migration once the embedding model is fixed for a deployment.
  embedding       Unsupported("vector")?
  // Generated column (GENERATED ALWAYS AS to_tsvector('simple', content) STORED) —
  // created with its expression + GIN index in migration 20260921000001_knowledge_fts.
  tsv             Unsupported("tsvector")?

  @@index([knowledgeBaseId])
  @@index([documentId])
  @@index([tenantId])
}

// ─────────────────────────────── Channel connections ───────────────────────────────

enum Channel {
  INSTAGRAM
  TELEGRAM
}

enum HealthStatus {
  UNKNOWN
  CONNECTED
  DEGRADED
  AUTH_REQUIRED
  PERMISSION_REQUIRED
  WEBHOOK_ERROR
  DISCONNECTED
}

model ChannelConnection {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel              Channel
  status               String       @default("disconnected") // connected | disconnected
  displayName          String       @default("")
  externalAccountId    String       @default("") // IG professional account user ID / Telegram bot ID
  credentialsEncrypted String       @default("") // AES-256-GCM encrypted JSON (tokens etc.)
  webhookSecret        String       @default("") // per-connection webhook secret (Telegram secret_token)
  metadata             Json         @default("{}")
  healthStatus         HealthStatus @default(UNKNOWN)
  healthDetail         String       @default("")
  lastHealthCheckAt    DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([tenantId, channel])
  @@index([channel, externalAccountId])
}

// ─────────────────────────────── CRM ───────────────────────────────

enum LeadStatus {
  NEW
  OPEN
  QUALIFIED
  CONVERTED
  LOST
  SPAM
}

model Lead {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source            Channel
  name              String?
  username          String?
  phone             String?
  email             String?
  language          String?
  intent            String?
  status            LeadStatus @default(NEW)
  score             Int        @default(0)
  tags              String[]   @default([])
  assignedToUserId  String?
  assignedTo        User?      @relation("AssignedLeads", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  qualification     Json       @default("{}") // collected qualification fields (budget, timeline, ...)
  mergedIntoId      String?
  mergedInto        Lead?      @relation("LeadMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        Lead[]     @relation("LeadMerge")
  lastInteractionAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  identities    LeadIdentity[]
  conversations Conversation[]
  notes         CrmNote[]
  handoffs      HumanHandoff[]
  registrations CourseRegistration[]

  @@index([tenantId, status])
  @@index([tenantId, lastInteractionAt])
}

model LeadIdentity {
  id         String   @id @default(cuid())
  tenantId   String
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    Channel
  externalId String // IGSID for Instagram messaging, IG commenter user id, Telegram user id
  username   String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, channel, externalId])
  @@index([leadId])
}

// ─────────────────────────────── Conversations ───────────────────────────────

enum ConversationStatus {
  ACTIVE
  HANDED_OFF
  CLOSED
}

enum ConversationKind {
  INSTAGRAM_COMMENT_THREAD
  INSTAGRAM_DM
  TELEGRAM_CHAT
  /**
   * A private chat of the owner's personal Telegram account.
   */
  TELEGRAM_PERSONAL_CHAT
}

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind             ConversationKind
  channel          Channel
  externalThreadId String // IGSID for DMs, telegram chat id, media_id:commenter_id for comment threads
  leadId           String?
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId          String?
  agent            Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status           ConversationStatus @default(ACTIVE)
  handedOffAt      DateTime?
  lastMessageAt    DateTime?
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  messages      ConversationMessage[]
  handoffs      HumanHandoff[]
  registrations CourseRegistration[]

  @@unique([tenantId, kind, externalThreadId])
  @@index([tenantId, lastMessageAt])
  @@index([leadId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageRole {
  USER
  AGENT
  OPERATOR
  SYSTEM
}

model ConversationMessage {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId          String
  direction         MessageDirection
  role              MessageRole
  content           String
  externalMessageId String? // channel-native message/comment id
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([tenantId])
}

// ─────────────────────────────── Events, executions, logs ───────────────────────────────

enum WebhookEventStatus {
  RECEIVED
  ENQUEUED
  PROCESSING
  PROCESSED
  SKIPPED
  FAILED
  DEAD_LETTER
}

model WebhookEvent {
  id          String             @id @default(cuid())
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  channel     Channel
  eventKey    String // dedup key: telegram "<connectionId>:<update_id>"; instagram derived per event
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  attempts    Int                @default(0)
  receivedAt  DateTime           @default(now())
  /**
   * Set when a worker atomically claims the event (stale-claim recovery).
   */
  claimedAt   DateTime?
  processedAt DateTime?

  @@unique([channel, eventKey])
  @@index([status, receivedAt])
  @@index([tenantId, receivedAt])
}

enum ExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model AIExecution {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversationId String?
  requestId      String
  model          String
  status         ExecutionStatus @default(RUNNING)
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  latencyMs      Int             @default(0)
  decision       Json?
  error          String?
  createdAt      DateTime        @default(now())

  toolExecutions ToolExecution[]

  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
}

model ToolExecution {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiExecutionId String?
  aiExecution   AIExecution?    @relation(fields: [aiExecutionId], references: [id], onDelete: SetNull)
  name          String
  input         Json
  output        Json?
  status        ExecutionStatus @default(RUNNING)
  error         String?
  latencyMs     Int             @default(0)
  createdAt     DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([aiExecutionId])
}

model CrmNote {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorType   String   @default("SYSTEM") // AGENT | OPERATOR | SYSTEM
  authorUserId String?
  content      String
  createdAt    DateTime @default(now())

  @@index([leadId, createdAt])
}

/**
 * A course registration — a lead who actually asked to enrol, as opposed to
 * anyone who merely said hello.
 * Deliberately separate from Lead: every inbound conversation creates a Lead,
 * but only a stated intent to register creates one of these, and the sales
 * team works this list rather than the firehose. It keeps the registration's
 * own lifecycle, its own assignee and its own audit trail, while staying
 * joined to the lead and the conversation it came from.
 */
/**
 * "Qo'shimcha AI ko'rsatmalari" — short business rules the owner writes in
 * their own words, without touching the system prompt.
 * Separate from both the knowledge base and the agent's systemInstructions.
 * The knowledge base answers "what is true" and is retrieved by relevance;
 * these answer "what to DO in situation X" and must always be in context, so
 * they are injected verbatim on every turn rather than searched for.
 * Scoped to the tenant, optionally narrowed to one channel, so the owner can
 * say something on Telegram that does not apply to Instagram.
 */
model OwnerInstruction {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /**
   * The rule, in the owner's own words.
   */
  text      String
  enabled   Boolean    @default(true)
  /**
   * null = every channel. Otherwise an AgentType this applies to.
   */
  appliesTo AgentType?
  /**
   * Manual ordering in the dashboard; lower first.
   */
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId, enabled])
}

enum RegistrationStatus {
  /**
   * Yangi ariza
   */
  NEW
  /**
   * Bog'lanish kerak
   */
  CONTACT_NEEDED
  /**
   * Mijoz bilan bog'lanildi
   */
  CONTACTED
  /**
   * Sinov darsi belgilandi
   */
  TRIAL_BOOKED
  /**
   * Kursga yozildi
   */
  ENROLLED
  /**
   * Yakunlandi
   */
  COMPLETED
  /**
   * Bekor qilindi
   */
  CANCELLED
}

model CourseRegistration {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /**
   * The conversation it was collected in; kept so staff can read the context.
   */
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  fullName      String
  phone         String
  course        String
  preferredTime String?
  note          String?

  /**
   * Where it came from, preserved even after the channel account is switched.
   */
  sourceChannel Channel
  sourceAccount String?

  status           RegistrationStatus @default(NEW)
  assignedToUserId String?
  assignedTo       User?              @relation("AssignedRegistrations", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RegistrationEvent[]

  /**
   * One registration per person per course. The agent re-reads intent on every
   * message, so without this a customer repeating themselves would file the
   * same application several times.
   */
  @@unique([tenantId, leadId, course])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/**
 * Who moved a registration to which status, and when.
 */
model RegistrationEvent {
  id             String              @id @default(cuid())
  registrationId String
  registration   CourseRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus     RegistrationStatus?
  toStatus       RegistrationStatus
  note           String?
  /**
   * Dashboard user, when the change came from the web CRM.
   */
  byUserId       String?
  /**
   * Telegram user id, when it came from the CRM bot.
   */
  byTelegramId   String?
  createdAt      DateTime            @default(now())

  @@index([registrationId, createdAt])
}

enum HandoffStatus {
  OPEN
  RESOLVED
}

model HumanHandoff {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  reason           String
  status           HandoffStatus @default(OPEN)
  resolvedByUserId String?
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([tenantId, status])
}

enum ManualActionStatus {
  PENDING
  DONE
  DISMISSED
}

model ManualAction {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       String // "Meta" | "Telegram" | "Infrastructure" | ...
  title          String
  officialUrl    String
  steps          String[]
  expectedResult String             @default("")
  whatToReturn   String             @default("")
  dedupKey       String
  status         ManualActionStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([tenantId, dedupKey])
  @@index([tenantId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  resource   String
  resourceId String   @default("")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ─────────────────────────────── Media library ───────────────────────────────

/**
 * Images the agents may send to customers (price lists, branch maps, course
 * banners…). Bytes live in Postgres (stateless app, same rationale as
 * KnowledgeFile); served publicly at GET /files/media/:id so Instagram can
 * fetch attachment URLs. The AI only ever references assets by id from the
 * list offered in its prompt — never arbitrary URLs.
 */
model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /**
   * Shown to the AI to decide WHEN this image is relevant — write it clearly.
   */
  description String   @default("")
  mimeType    String
  sizeBytes   Int      @default(0)
  data        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────── Platform settings ───────────────────────────────

/**
 * Operator-editable platform configuration stored encrypted (AES-256-GCM) —
 * e.g. the Anthropic API key and Meta app credentials pasted in the dashboard
 * Settings page. Values here take precedence over the matching env variables,
 * so keys can be rotated without redeploying.
 */
model AppSetting {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String
  valueEncrypted String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, key])
}

// ─────────────────────────── Telegram personal accounts ───────────────────────────

/**
 * One row per PERSONAL Telegram account connected to the bot via Telegram
 * Business (Settings → Chat Automation). Multiple people can connect the same
 * bot; each gets independent admin controls: an enable toggle, optional
 * per-account instructions and knowledge base (falling back to the
 * TELEGRAM_PERSONAL agent's defaults when null).
 */
model TelegramPersonalAccount {
  id                   String         @id @default(cuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /**
   * Telegram's business_connection.id — stable handle for sending replies.
   */
  businessConnectionId String         @unique
  /**
   * Telegram user id of the account owner (string: exceeds 2^31).
   */
  ownerUserId          String
  ownerName            String         @default("")
  ownerUsername        String?
  userChatId           String         @default("")
  /**
   * Telegram-side state: owner can disable the connection in their app.
   */
  isEnabled            Boolean        @default(true)
  canReply             Boolean        @default(false)
  canReadMessages      Boolean        @default(false)
  connectedAt          DateTime       @default(now())
  /**
   * Admin-side automation toggle — OFF by default until explicitly enabled.
   */
  enabled              Boolean        @default(false)
  displayName          String         @default("")
  /**
   * Per-account instruction override; null → TELEGRAM_PERSONAL agent default.
   */
  instructions         String?
  knowledgeBaseId      String?
  knowledgeBase        KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  settings             Json           @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([tenantId])
}

// Generic idempotency guard for side effects (e.g. "reply to comment X", "private reply to comment X").
model IdempotencyKey {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@index([createdAt])
}
